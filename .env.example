# copy to .env and fill in before running docker compose up

# takatime mongodb

# root credentials for the bundled mongo, only set on first start
# keep the password url safe, generate with: openssl rand -hex 24
MONGO_USERNAME=takatime
MONGO_PASSWORD=

# host interface and port mongo is published on, editor plugins connect here
# use 0.0.0.0 to reach it from other machines
# editor connection string: mongodb://<MONGO_USERNAME>:<MONGO_PASSWORD>@<host>:<MONGO_PORT>/?authSource=admin
MONGO_BIND=127.0.0.1
MONGO_PORT=27017

# takaweb

# better auth session secret, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# public url takaweb is served from, used for auth callbacks
TAKAWEB_URL=http://localhost:4321

# comma separated list of emails allowed to sign in, empty allows anyone
TAKAWEB_ALLOWED_EMAILS=

# host interface and port takaweb is published on, use 0.0.0.0 to expose beyond localhost
TAKAWEB_BIND=127.0.0.1
TAKAWEB_PORT=4321

# github oauth (optional)
# callback url: <TAKAWEB_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# gitlab oauth (optional)
# callback url: <TAKAWEB_URL>/api/auth/callback/gitlab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# change for self hosted gitlab instances
GITLAB_ISSUER=https://gitlab.com

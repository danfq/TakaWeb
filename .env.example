# copy to .env and fill in before running docker compose up

# takatime mongodb

# root credentials for the bundled mongo, only set on first start
# keep the password url safe, generate with: openssl rand -hex 24
MONGO_USERNAME=takatime
MONGO_PASSWORD=

# read-only user takaweb connects with, it can only read the takatime database
# created and kept in sync by the mongo-init service on every start
# must differ from MONGO_USERNAME, keep the password url safe, generate with: openssl rand -hex 24
MONGO_READONLY_USERNAME=takaweb
MONGO_READONLY_PASSWORD=

# host interface and port mongo is published on, editor plugins connect here
# use 0.0.0.0 to reach it from other machines
# editor connection string: mongodb://<MONGO_USERNAME>:<MONGO_PASSWORD>@<host>:<MONGO_PORT>/?authSource=admin&directConnection=true
MONGO_BIND=127.0.0.1
MONGO_PORT=27017

# mongo runs as a single node replica set so takaweb gets changes pushed live
# editors connecting without directConnection=true are redirected to this address,
# so set it to the hostname or ip other machines reach mongo at when MONGO_BIND exposes it
MONGO_PUBLIC_HOST=127.0.0.1

# takaweb

# takaweb data (auth, settings) lives in its own sqlite db, never in the takatime mongo
# compose keeps it on the takaweb-db volume, locally it defaults to ./data
# TAKAWEB_DATA_DIR=data

# public url takaweb is served from, https enables secure cookies
TAKAWEB_URL=http://localhost:4321

# host interface and port takaweb is published on, use 0.0.0.0 to expose beyond localhost
TAKAWEB_BIND=127.0.0.1
TAKAWEB_PORT=4321

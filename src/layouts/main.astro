---
import "@/styles/global.css"
import { cn } from "cn"
import Header from "@/components/layout/header.astro"
import { FOCUS_SCRIPT } from "@/lib/focus"
import { cspHash } from "@/lib/server/csp"
import { getSettings } from "@/lib/server/settings"
import { TZ_SCRIPT } from "@/lib/stats/view"
import { THEME_SCRIPT, themeCss } from "@/lib/themes"

interface Props {
  title?: string
  // fixed viewport shell, the page renders its own header and never scrolls
  app?: boolean
}

const { title, app = false } = Astro.props
const { user } = Astro.locals

// rendered from the stored settings, so hidden names never flash
const hideNames = !!user && getSettings(user.id).hideNames

// astro only hashes what it bundles, the inline head code is allowed by hash here
// there is no policy, nor csp, while developing
const themes = themeCss()

for (const script of [THEME_SCRIPT, TZ_SCRIPT, FOCUS_SCRIPT]) Astro.csp?.insertScriptHash(cspHash(script))
Astro.csp?.insertStyleHash(cspHash(themes))
---

{/* english only for now, other languages are planned */}
<html lang="en" data-private={hideNames ? "" : undefined}>
  <head>
    {/* meta */}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    {/* theme */}
    <style is:inline set:html={themes} />
    <script is:inline set:html={THEME_SCRIPT} />
    {/* lets the server render dates in the browser's timezone */}
    <script is:inline set:html={TZ_SCRIPT} />
    {/* focus outlines for keyboard navigation only */}
    <script is:inline set:html={FOCUS_SCRIPT} />
    {/* icons & fonts */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preload" href="/static/fonts/figtree_variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/static/fonts/inter_variable.woff2" as="font" type="font/woff2" crossorigin />

    {/* title */}
    <title>{title ? `${title} · TakaWeb` : "TakaWeb"}</title>
  </head>
  <body class={cn("flex flex-col", app ? "h-svh overflow-hidden" : "min-h-svh")}>
    {!app && <Header />}
    <slot />
  </body>
</html>
